# Example only. Configure actual values in Render, never commit credentials.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
TRUST_PROXY=1
MAX_ROOMS=20
APP_ORIGINS=https://your-game.vercel.app
# Runtime role, pooled Neon hostname; same project/branch/database as direct URL.
DATABASE_URL=postgresql://fishing_app:REPLACE@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connection_limit=8&pool_timeout=20&connect_timeout=15
# Runtime role, unpooled endpoint for the session advisory lock.
DIRECT_DATABASE_URL=postgresql://fishing_app:REPLACE@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Database owner/migration role, unpooled endpoint, used only by --migrate.
MIGRATION_DATABASE_URL=postgresql://neondb_owner:REPLACE@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
METRICS_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
