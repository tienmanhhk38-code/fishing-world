{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @fishing/client build",
  "outputDirectory": "apps/client/dist",
  "headers": [
    {"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Frame-Options","value":"DENY"},{"key":"Referrer-Policy","value":"same-origin"}]},
    {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"no-store"}]}
  ]
}
